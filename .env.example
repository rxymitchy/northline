# OpenAI — required for ICP parsing, research reasoning, scoring rationale, outreach
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Search provider: duckduckgo | tavily | serper | brave
# duckduckgo is free (no key). Tavily/Serper/Brave are more reliable for Kenya results.
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# Funnel limits (cost control)
MAX_DISCOVER=36
MAX_DEEP_RESEARCH=22
MAX_OUTREACH=18
CHEAP_FILTER_MIN_SCORE=35

# HTTP
FETCH_TIMEOUT_SECONDS=20
FETCH_DELAY_SECONDS=1.2
USER_AGENT=FindClientsAgent/1.0 (personal research; respect robots.txt)

# App
DATABASE_URL=sqlite:///./data/prospects.db
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Visitor reports send as normal SMTP mail (Gmail, etc.) when host/from/password are set.
# Cold outbound also needs EMAIL_SENDING_ENABLED=true.
EMAIL_SENDING_ENABLED=false
OUTBOUND_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Northline
SMTP_USE_TLS=true
OUTBOUND_SEND_DELAY_SECONDS=4
ADMIN_PIN=northline
